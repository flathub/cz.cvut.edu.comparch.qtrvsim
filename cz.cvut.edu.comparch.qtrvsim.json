{
    "app-id" : "cz.cvut.edu.comparch.qtrvsim",
    "runtime" : "org.kde.Platform",
    "runtime-version" : "6.10",
    "sdk" : "org.kde.Sdk",
    "command" : "qtrvsim_gui",
    "rename-desktop-file" : "qtrvsim.desktop",
    "rename-icon" : "qtrvsim_gui",
    "finish-args" : [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules" : [
        {
            "name" : "qtrvsim",
            "buildsystem" : "cmake-ninja",
            "builddir" : true,
            "config-opts" : [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/cvut/qtrvsim/archive/refs/tags/v0.9.9.tar.gz",
                    "sha512": "88590c068fc3ce60c0a3c48b26b52220372ffe455dc2e3c8fec0b82a474e5d2e28abaea78b7543cd7d17b677f542faae53fe8c928dde7d80be382d304ac5a206",
                    "x-checker-data": {
			    "type": "git",
			    "tag-pattern": "^v([\\d.]+)$"
			}
                }
            ]
        }
    ]
}
